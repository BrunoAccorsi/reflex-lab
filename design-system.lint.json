{
  "rules": {
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^Card$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^Button$",
            "allow": ["layout", "color", "border"]
          },
          {
            "pattern": "^Alert$",
            "allow": ["layout", "color", "border"]
          }
        ],
        "message": {
          "spacing": "Use the shared spacing scale (p-3, p-4, p-5, p-6, or p-7) on {{component}}.",
          "default": "Use a {{component}} variant or the shared design tokens; keep page-specific classes limited to layout."
        }
      }
    ],
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/require-static-classes": "error"
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off"
      }
    }
  ]
}
